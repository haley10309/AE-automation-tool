{
  "name": "ae-automation-tool",
  "version": "1.0.0",
  "description": "AE Automation Tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:client && electron-builder"
  },
  "build": {
    "appId": "com.samsung.ae-automation-tool",
    "productName": "AE Automation Tool",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "language": "1042"
    },
    "files": [
      "main.js",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!.gitignore"
        ]
      },
      {
        "from": "client/dist",
        "to": "client/dist"
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "author": "Samsung AE"
}